{
  "name": "tds-bookmark-manager-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:all": "pnpm -r run clean:all && rimraf node_modules pnpm-lock.yaml",
    "build": "pnpm -r run build",
    "build:ui": "pnpm --filter=tds-bookmark-manager-ui run build",
    "build:api": "pnpm --filter=tds-bookmark-manager-api run build",
    "test:api": "pnpm --filter=tds-bookmark-manager-api run test",
    "test:api:cov": "pnpm --filter=tds-bookmark-manager-api run test:cov",
    "test:api:e2e": "pnpm --filter=tds-bookmark-manager-api run test:e2e",
    "format": "pnpm -r run format",
    "start:ui:dev": "pnpm --filter=tds-bookmark-manager-ui run dev",
    "start:api:dev": "pnpm --filter=tds-bookmark-manager-api run start:dev",
    "start:dev": "run-p -l start:ui:dev start:api:dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.31.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  }
}
