{
  "name": "@tds/tds-bookmark-manager-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "apps/ui/*",
    "apps/backend/*"
  ],
  "scripts": {
    "build:all": "run-s clean build:lib:common build:api build:ui",
    "build:api": "nx run @tds/tds-bookmark-manager-api:build",
    "build:lib:common": "nx run @tds/tds-bm-common:build",
    "build:ui": "nx run @tds/tds-bookmark-manager-ui:build",
    "clean": "run-s nx:reset clean:lib:common clean:api clean:ui",
    "clean:all": "run-s nx:reset clean:lib:common clean:ui clean:api clean:all:cmd",
    "clean:all:cmd": "rimraf node_modules package-lock.json",
    "clean:api": "rimraf apps/backend/tds-bookmark-manager-api/dist apps/backend/tds-bookmark-manager-api/dist-migrations apps/backend/tds-bookmark-manager-api/test-output apps/backend/tds-bookmark-manager-api/out-tsc",
    "clean:lib:common": "rimraf libs/tds-bm-common/dist",
    "clean:ui": "rimraf node_modules/.vite apps/ui/tds-bookmark-manager-ui/test-output apps/ui/tds-bookmark-manager-ui/dist apps/ui/tds-bookmark-manager-ui/coverage apps/ui/tds-bookmark-manager-ui/html apps/ui/tds-bookmark-manager-ui/results apps/ui/tds-bookmark-manager-ui/node_modules",
    "docker:build:versioned": "export IMAGE_TAG=$(node -p \"require('./package.json').version\") && docker compose -f docker-compose.develop.yml build",
    "docker:dev:down": "docker compose -f docker-compose.develop.yml down",
    "docker:dev:down:remove": "docker compose -f docker-compose.develop.yml down -v",
    "docker:dev:start": "docker compose -f docker-compose.develop.yml start",
    "docker:dev:stop": "docker compose -f docker-compose.develop.yml stop",
    "docker:dev:up": "NODE_ENV=docker docker compose -f docker-compose.develop.yml up -d",
    "docker:dev:up:build": "NODE_ENV=docker docker compose -f docker-compose.develop.yml up --build -d",
    "lint:api": "nx run @tds/tds-bookmark-manager-api:lint",
    "lint:api:fix": "nx run @tds/tds-bookmark-manager-api:lint --fix",
    "lint:lib:common": "nx run @tds/tds-bm-common:lint",
    "lint:lib:common:fix": "nx run @tds/tds-bm-common:lint --fix",
    "lint:ui": "nx run @tds/tds-bookmark-manager-ui:lint",
    "lint:ui:fix": "nx run @tds/tds-bookmark-manager-ui:lint --fix",
    "migration:generate": "run-s clean:lib:common clean:api build:lib:common typeorm:cli:build && npm run typeorm migration:generate",
    "migration:revert": "run-s clean:lib:common clean:api build:lib:common typeorm:cli:build && npm run typeorm migration:revert",
    "migration:run": "run-s clean:lib:common clean:api build:lib:common typeorm:cli:build && npm run typeorm migration:run",
    "migration:show": "run-s clean:lib:common clean:api build:lib:common typeorm:cli:build && npm run typeorm migration:show",
    "nx:graph": "nx graph",
    "nx:migrate": "nx migrate 21.2.0",
    "nx:reset": "nx reset",
    "nx:show:api": "nx show project @tds/tds-bookmark-manager-api --web",
    "nx:show:ui": "nx show project @tds/tds-bookmark-manager-ui --web",
    "release:tag": "VERSION=$(node -p \"require('./package.json').version\") && MAJOR=$(echo $VERSION | cut -d. -f1) && MINOR=$(echo $VERSION | cut -d. -f2) && CUSTOM_TAG=\"v${MAJOR}.${MINOR}.x/${VERSION}\" && git tag -a \"${CUSTOM_TAG}\" -m \"Release ${VERSION}\" && echo \"Git tag '${CUSTOM_TAG}' created successfully.\"",
    "sort:packagejson": "sort-package-json",
    "start:all:dev": "run-p -l start:api:dev start:ui:dev",
    "start:api:dev": "nx run @tds/tds-bookmark-manager-api:serve:development",
    "start:api:docker": "nx run @tds/tds-bookmark-manager-api:serve:docker",
    "start:api:prod": "nx run @tds/tds-bookmark-manager-api:serve:production",
    "start:ui:dev": "nx run @tds/tds-bookmark-manager-ui:dev",
    "test:all": "run-p -l test:api test:ui",
    "test:all:cov": "run-p -l test:api:cov test:ui:cov",
    "test:api": "nx run @tds/tds-bookmark-manager-api:test",
    "test:api:cov": "nx run @tds/tds-bookmark-manager-api:test -- --coverage",
    "test:api:e2e": "jest --config ./test/jest-e2e.json",
    "test:api:watch": "nx run @tds/tds-bookmark-manager-api:test -- --watch",
    "test:ui": "VITE_USE_MOCK_API=true nx run @tds/tds-bookmark-manager-ui:test -- --run",
    "test:ui:cov": "VITE_USE_MOCK_API=true nx run @tds/tds-bookmark-manager-ui:test -- --run --coverage",
    "test:ui:web": "VITE_USE_MOCK_API=true nx run @tds/tds-bookmark-manager-ui:test -- --ui --coverage",
    "typeorm": "typeorm -d apps/backend/tds-bookmark-manager-api/dist-migrations/apps/backend/tds-bookmark-manager-api/src/db/data-source.js",
    "typeorm:cli:build": "tsc -p apps/backend/tds-bookmark-manager-api/tsconfig.typeorm.json",
    "typeorm:docker": "typeorm -d dist-migrations/apps/backend/tds-bookmark-manager-api/src/db/data-source.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/passport-http-bearer": "^1.0.41",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.0.0",
    "cheerio": "^1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "i18next": "^25.2.1",
    "joi": "^17.13.3",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "morgan": "^1.10.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pino-http": "^10.5.0",
    "pino-noir": "^2.2.1",
    "pino-pretty": "^13.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.5.2",
    "react-router-dom": "6.29.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "21.2.0",
    "@nx/eslint": "21.2.0",
    "@nx/eslint-plugin": "21.2.0",
    "@nx/jest": "21.2.0",
    "@nx/js": "21.2.0",
    "@nx/nest": "21.2.0",
    "@nx/node": "21.2.0",
    "@nx/playwright": "21.2.0",
    "@nx/react": "21.2.0",
    "@nx/vite": "21.2.0",
    "@nx/web": "21.2.0",
    "@nx/webpack": "21.2.0",
    "@nx/workspace": "21.2.0",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.36",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
