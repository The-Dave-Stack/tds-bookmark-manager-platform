{
  "name": "@tds/tds-bookmark-manager-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "apps/ui/*",
    "apps/backend/*"
  ],
  "scripts": {
    "build:api": "nx run @tds/tds-bookmark-manager-api:build",
    "build:ui": "nx run @tds/tds-bookmark-manager-ui:build",
    "clean:all": "run-s clean:all:ui clean:all:api clean:all:cmd",
    "clean:all:api": "rimraf apps/backend/tds-bookmark-manager-api/dist apps/backend/tds-bookmark-manager-api/test-output",
    "clean:all:cmd": "rimraf node_modules package-lock.json pnpm-lock.yaml",
    "clean:all:ui": "rimraf apps/ui/tds-bookmark-manager-ui/dist apps/ui/tds-bookmark-manager-ui/coverage apps/ui/tds-bookmark-manager-ui/html apps/ui/tds-bookmark-manager-ui/results apps/ui/tds-bookmark-manager-ui/node_modules",
    "clean:api": "rimraf apps/backend/tds-bookmark-manager-api/dist",
    "lint:api": "nx run @tds/tds-bookmark-manager-api:lint",
    "lint:ui": "nx run @tds/tds-bookmark-manager-ui:lint",
    "migration:generate": "pnpm run clean:api && pnpm run typeorm:cli:build && pnpm typeorm migration:generate",
    "migration:revert": "pnpm run clean:api && pnpm run typeorm:cli:build && pnpm typeorm migration:revert",
    "migration:run": "pnpm run clean:api && pnpm run typeorm:cli:build && pnpm typeorm migration:run",
    "migration:show": "pnpm run clean:api && pnpm run typeorm:cli:build && pnpm typeorm migration:show",
    "nx:migrate": "nx migrate 21.2.0-beta.2",
    "nx:show:api": "nx show project @tds/tds-bookmark-manager-api --web",
    "nx:show:ui": "nx show project @tds/tds-bookmark-manager-ui --web",
    "start:api:dev": "nx run @tds/tds-bookmark-manager-api:serve:development",
    "start:ui:dev": "nx run @tds/tds-bookmark-manager-ui:dev",
    "test:api": "nx run @tds/tds-bookmark-manager-api:test",
    "test:api:cov": "nx run @tds/tds-bookmark-manager-api:test -- --coverage",
    "test:api:e2e": "jest --config ./test/jest-e2e.json",
    "test:api:watch": "nx run @tds/tds-bookmark-manager-api:test -- --watch",
    "test:ui": "nx run @tds/tds-bookmark-manager-ui:test -- --run",
    "test:ui:cov": "nx run @tds/tds-bookmark-manager-ui:test -- --run --coverage",
    "test:ui:web": "nx run @tds/tds-bookmark-manager-ui:test -- --ui --coverage",
    "typeorm": "typeorm -d apps/backend/tds-bookmark-manager-api/dist/cli/db/data-source.js",
    "typeorm:cli:build": "pnpm tsc -p apps/backend/tds-bookmark-manager-api/tsconfig.typeorm.json"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "i18next": "^25.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "morgan": "^1.10.0",
    "nestjs-pino": "^4.4.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pino-http": "^10.5.0",
    "pino-noir": "^2.2.1",
    "pino-pretty": "^13.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.5.2",
    "react-router-dom": "6.29.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.24",
    "validator": "^13.15.15",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "21.2.0-beta.2",
    "@nx/eslint": "21.2.0-beta.2",
    "@nx/eslint-plugin": "21.2.0-beta.2",
    "@nx/jest": "21.2.0-beta.2",
    "@nx/js": "21.2.0-beta.2",
    "@nx/nest": "21.2.0-beta.2",
    "@nx/node": "21.2.0-beta.2",
    "@nx/playwright": "21.2.0-beta.2",
    "@nx/react": "21.2.0-beta.2",
    "@nx/vite": "21.2.0-beta.2",
    "@nx/web": "21.2.0-beta.2",
    "@nx/webpack": "21.2.0-beta.2",
    "@nx/workspace": "21.2.0-beta.2",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.36",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "happy-dom": "^17.6.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "npm-run-all": "^4.1.5",
    "nx": "21.2.0-beta.2",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "webpack-cli": "^5.1.4"
  }
}
